# ============================================================
# Fluence AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------------
# Supabase — https://app.supabase.com/project/<your-project>/settings/api
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------
# DeepSeek AI (OpenAI-compatible API)
# https://platform.deepseek.com/api_keys
# ------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Auth — generate a secret: openssl rand -base64 32
# ------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-here

# ------------------------------------------------------------------
# Stripe (optional — for subscription billing)
# https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ------------------------------------------------------------------
# Email (optional — for transactional emails via Resend)
# https://resend.com/api-keys
# ------------------------------------------------------------------
# RESEND_API_KEY=re_your-resend-api-key
# EMAIL_FROM=noreply@yourdomain.com
